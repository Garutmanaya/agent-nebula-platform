# Agent Nebula Platform - A2A 1.0 client configuration.
# This file configures local client/transport capabilities only. Remote Agent
# Card security requirements remain authoritative and are negotiated in Step 5.

[client]
streaming = true
polling = false
supported_protocol_bindings = ["JSONRPC", "HTTP+JSON"]
# false preserves the remote Agent Card's supportedInterfaces preference order.
use_client_preference = false
accepted_output_modes = ["application/json"]
timeout_seconds = 30.0
# Optional override. Omit to use /.well-known/agent-card.json.
# agent_card_path = ".well-known/agent-card.json"

[client.tls]
enabled = true
# When enabled, TLS peer verification is mandatory. Relative paths are resolved from this file.
# trust_bundle = "../certs/trust/trust-bundle.pem"
# Omit trust_bundle to use the operating system CA store.

# Optional client TLS identity. Both values must be configured together.
# This only establishes the transport identity; Step 5 decides whether a remote
# A2A security requirement actually requires mTLS.
# certificate_file = "../certs/client.crt"
# private_key_file = "../secrets/client.key"

# Optional opaque credentials. Table names are arbitrary Agent Card security
# scheme keys; Platform never assigns semantics from the key itself.
# Secrets remain external files and are never embedded in this configuration.
# [client.credentials.partner_api]
# secret_file = "../secrets/partner-api-key"
#
# [client.credentials.legacy_http]
# secret_file = "../secrets/http-credential"
#
# [client.credentials.corporate_oidc]
# secret_file = "../secrets/oidc-access-token"
